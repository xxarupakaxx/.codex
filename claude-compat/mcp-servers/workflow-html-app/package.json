{
  "name": "workflow-html-app",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP Apps server for interactive HTML workflow viewers",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "node scripts/copy-static-ui.mjs --build",
    "dev": "tsx watch main.ts",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dompurify": "^3.4.14",
    "marked": "^15.0.0",
    "mermaid": "^11.17.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.61.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "hono": "4.13.5",
    "ip-address": "10.5.0",
    "body-parser": "2.3.0",
    "@hono/node-server": "2.1.1"
  }
}
