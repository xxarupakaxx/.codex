    {
      "id": "viewer-tests",
      "title": "Viewer model tests",
      "kind": "test",
      "lane": "verification",
      "path": "tests/codemap-viewer.test.mjs",
      "summary": "Guards lanes, evidence, unknown relations, and Roadmap compatibility."
    }
