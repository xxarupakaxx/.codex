    {
      "id": "generator-tests",
      "title": "Generator contract tests",
      "kind": "test",
      "lane": "verification",
      "path": "tests/test_generate_codemap.py",
      "summary": "Guards schema, fingerprints, partial failures, and lock-last ordering."
